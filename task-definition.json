{
  "family": "telco-churn-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::312844854917:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "telco-churn-ml",
      "image": "312844854917.dkr.ecr.ap-southeast-1.amazonaws.com/telco-churn-ml:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/telco-churn",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}